# ============ 运行环境 ============
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# 前端地址白名单，多个用逗号分隔
CORS_ORIGIN=http://localhost:5173
# 部署在 Nginx/网关之后时设为 true，否则限流拿不到真实 IP
TRUST_PROXY=false

# ============ 安全密钥（必须改） ============
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 生产环境要求长度 >= 32，否则服务拒绝启动
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=1209600

# ============ 数据存储 ============
DATA_DIR=./data
DB_PATH=./data/agentchat.db

# ============ 模型服务（OpenAI 兼容协议） ============
# 可选：siliconflow | dashscope | openai | deepseek
LLM_PROVIDER=siliconflow
# API Key 只从环境变量读取，永不落库
LLM_API_KEY=
# 以下留空则使用所选 provider 的默认值
LLM_BASE_URL=
# 主模型需要可靠的 function calling 能力，否则工具不会被真正调用。
# 硅基流动推荐：Qwen/Qwen3-8B（默认）、Qwen/Qwen2.5-72B-Instruct、deepseek-ai/DeepSeek-V3
# 不建议用 7B 及以下的小模型作为主模型
LLM_CHAT_MODEL=
# 轻量模型，仅用于上下文摘要与记忆抽取，无需工具能力
LLM_FAST_MODEL=
LLM_EMBED_MODEL=
LLM_TIMEOUT_MS=120000

# ============ Agent 运行时 ============
RUNTIME_MAX_AGENTS=50
RUNTIME_TTL_MS=1800000
SESSION_TTL_MS=3600000
MAX_SESSIONS_PER_AGENT=200
AGENT_MAX_ITERATIONS=12
AGENT_MAX_HISTORY=24
AGENT_TEMPERATURE=0.7

# ============ 长期记忆 ============
MEMORY_ENABLED=true
MEMORY_UPDATE_INTERVAL=6
MEMORY_MAX_LENGTH=1200

# ============ 知识库检索 ============
RAG_TOP_K=4
RAG_MIN_SCORE=0.25

# ============ 其它 ============
LOG_LEVEL=info
# 允许 fetch_webpage 访问内网地址（存在 SSRF 风险，仅私有化部署且明确知晓风险时开启）
ALLOW_INTERNAL_NETWORK=false
